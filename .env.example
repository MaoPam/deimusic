# Copiar como .env.local y ajustar. .env.local NO se versiona.

# true  -> reproductor simulado en memoria, no hace falta backend ni Raspberry (por defecto)
# false -> el front habla con la API real
VITE_DEMO=true

# Solo se usa con VITE_DEMO=false: dirección del backend (Raspberry Pi en la red local)
VITE_BACKEND=http://192.168.1.100:3000
